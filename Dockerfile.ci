# Stage 1: Build environment with VM tool
FROM rust:1.98-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS builder

# Build the reviewed checkout instead of an unrelated mutable crates.io release.
WORKDIR /source
COPY rust/ .
RUN cargo install --locked --path vm

# Verify installation
RUN vm --version

# Stage 2: Runtime environment
FROM ubuntu:22.04@sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc

# Copy VM binary from builder
COPY --from=builder /usr/local/cargo/bin/vm /usr/local/bin/vm

# Install Docker CLI (to manage nested containers)
RUN apt-get update && \
    apt-get install -y docker.io && \
    rm -rf /var/lib/apt/lists/*

# Create test project
WORKDIR /app
RUN echo '{"name": "docker-ci-test", "version": "1.0.0"}' > package.json

# Test that VM can be invoked
RUN vm --version
RUN vm --help

# Entry point for CI tests
CMD ["vm", "create", "--force"]
